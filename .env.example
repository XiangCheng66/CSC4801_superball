# Copy to .env. manage.py loads it; Docker Compose also reads it.
# Local/demo only. Replace both placeholders before sharing the environment.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_ENGINE=postgresql
POSTGRES_DB=superball
POSTGRES_USER=superball
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=0
# Explicitly enable known local/demo accounts in the local Compose setup.
SEED_AUTH_DEMO=1
